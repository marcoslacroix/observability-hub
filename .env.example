# ==============================================================================
# Observability Hub - Exemplo de Variáveis de Ambiente (.env.example)
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha as credenciais reais no arquivo .env local.
# 3. O arquivo .env está no .gitignore e NUNCA deve ser commitado no Git.
# ==============================================================================

# Credenciais de Administrador do Grafana (padrão local: admin / admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Integração Atlassian Jira Cloud (Infinity Datasource no Grafana)
URL_JIRA=https://sua-empresa.atlassian.net
EMAIL_JIRA=usuario@empresa.com
TOKEN_JIRA=seu_api_token_jira_aqui
JIRA_USER_LABEL=Dev

# Responsáveis do Jira (Dashboard - Issues por Responsável)
JIRA_ASSIGNEE_1_LABEL=Dev 1
JIRA_ASSIGNEE_1_NAME=Nome Dev 1
JIRA_ASSIGNEE_2_LABEL=Dev 2
JIRA_ASSIGNEE_2_NAME=Nome Dev 2
JIRA_ASSIGNEE_3_LABEL=Dev 3
JIRA_ASSIGNEE_3_NAME=Nome Dev 3
JIRA_ASSIGNEE_4_LABEL=Dev 4
JIRA_ASSIGNEE_4_NAME=Nome Dev 4
JIRA_ASSIGNEE_5_LABEL=Dev 5
JIRA_ASSIGNEE_5_NAME=Nome Dev 5
JIRA_ASSIGNEE_6_LABEL=Dev 6
JIRA_ASSIGNEE_6_NAME=Nome Dev 6
JIRA_ASSIGNEE_7_LABEL=Dev 7
JIRA_ASSIGNEE_7_NAME=Nome Dev 7
JIRA_ASSIGNEE_8_LABEL=Dev 8
JIRA_ASSIGNEE_8_NAME=Nome Dev 8
JIRA_ASSIGNEE_9_LABEL=Dev 9
JIRA_ASSIGNEE_9_NAME=Nome Dev 9
JIRA_ASSIGNEE_10_LABEL=Dev 10
JIRA_ASSIGNEE_10_NAME=Nome Dev 10
JIRA_ASSIGNEE_11_LABEL=Dev 11
JIRA_ASSIGNEE_11_NAME=Nome Dev 11

# Integração Atlassian Bitbucket Cloud (Infinity Datasource no Grafana)
BITBUCKET_WORKSPACE=seu-workspace
BITBUCKET_USER=seu-usuario-ou-email
BITBUCKET_APP_PASSWORD=sua-app-password-aqui

# Configurações de E-mail para Alertas do Grafana
# Por padrão usa o Mailpit local (http://localhost:8025).
# Para usar Gmail ou SMTP corporativo externo, configure SMTP_HOST (ex: smtp.gmail.com:587), SMTP_USER e SMTP_PASSWORD.
ALERT_EMAIL_TO=alertas@empresa.com
SMTP_HOST=mailpit:1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=alertas@observability-hub.local
