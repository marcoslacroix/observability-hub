{
  "uid": "jira-overview-dashboard",
  "title": "Jira - Issues, Sprints, Velocidade & Lead Time",
  "tags": ["jira", "agile", "sprint", "issues", "lead-time"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 10,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "jira_url",
        "label": "URL do Jira",
        "type": "textbox",
        "query": "${JIRA_URL}",
        "current": {
          "selected": true,
          "text": "${JIRA_URL}",
          "value": "${JIRA_URL}"
        },
        "hide": 2
      },
      {
        "name": "consulta_jql",
        "label": "Filtro / Visão do Jira",
        "type": "custom",
        "query": "Empresa Toda - Ano Atual (Desde 01/Jan) : created >= startOfYear(),Empresa Toda - Últimos 365 dias : created >= -365d,Minhas Issues no Ano Atual (${JIRA_USER_LABEL}) : created >= startOfYear() AND assignee = currentUser(),Minhas Issues nos Últimos 365 dias (${JIRA_USER_LABEL}) : created >= -365d AND assignee = currentUser(),Minhas Concluídas no Ano Atual (${JIRA_USER_LABEL}) : created >= startOfYear() AND assignee = currentUser() AND statusCategory = 'Done',Minha Sprint Atual (${JIRA_USER_LABEL}) : sprint in openSprints() AND assignee = currentUser(),Empresa Toda - Sprint Atual : sprint in openSprints(),Empresa Toda - Últimos 30 dias : created >= -30d",
        "current": {
          "selected": true,
          "text": "Empresa Toda - Ano Atual (Desde 01/Jan)",
          "value": "created >= startOfYear()"
        },
        "options": [
          {
            "selected": true,
            "text": "Empresa Toda - Ano Atual (Desde 01/Jan)",
            "value": "created >= startOfYear()"
          },
          {
            "selected": false,
            "text": "Empresa Toda - Últimos 365 dias",
            "value": "created >= -365d"
          },
          {
            "selected": false,
            "text": "Minhas Issues no Ano Atual (${JIRA_USER_LABEL})",
            "value": "created >= startOfYear() AND assignee = currentUser()"
          },
          {
            "selected": false,
            "text": "Minhas Issues nos Últimos 365 dias (${JIRA_USER_LABEL})",
            "value": "created >= -365d AND assignee = currentUser()"
          },
          {
            "selected": false,
            "text": "Minhas Concluídas no Ano Atual (${JIRA_USER_LABEL})",
            "value": "created >= startOfYear() AND assignee = currentUser() AND statusCategory = 'Done'"
          },
          {
            "selected": false,
            "text": "Minha Sprint Atual (${JIRA_USER_LABEL})",
            "value": "sprint in openSprints() AND assignee = currentUser()"
          },
          {
            "selected": false,
            "text": "Empresa Toda - Sprint Atual",
            "value": "sprint in openSprints()"
          },
          {
            "selected": false,
            "text": "Empresa Toda - Últimos 30 dias",
            "value": "created >= -30d"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Contagem Global no Jira (Sem limite de 100 itens - Conta 100% das Issues)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total de Issues (Filtro Atual)",
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "jira" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^Total$/", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "jira" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "simple",
          "root_selector": "",
          "columns": [{ "selector": "count", "text": "Total", "type": "number" }],
          "url": "${jira_url}/rest/api/3/search/approximate-count",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"jql\": \"${consulta_jql:raw}\"}"
