    {
      "type": "row",
      "title": "Repositórios & Projetos do Workspace",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 8,
      "panels": []
    },
    {
      "type": "table",
      "title": "Lista de Repositórios do Workspace (Clique para abrir no Bitbucket)",
      "id": 9,
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Nome do Repositório" },
            "properties": [
              { "id": "custom.width", "value": 220 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Abrir repositório no Bitbucket",
                    "url": "https://bitbucket.org/${workspace}/${__data.fields.Slug}",
                    "targetBlank": true
                  },
                  {
                    "title": "Filtrar este repositório no Dashboard",
                    "url": "/d/bitbucket-overview-dashboard?var-workspace=${workspace}&var-repo_slug=${__data.fields.Slug}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Slug" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "Projeto" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          },
          {
            "matcher": { "id": "byName", "options": "Linguagem" },
            "properties": [{ "id": "custom.width", "value": 130 }]
          },
          {
            "matcher": { "id": "byName", "options": "Branch Principal" },
            "properties": [{ "id": "custom.width", "value": 140 }]
          },
          {
            "matcher": { "id": "byName", "options": "Privado" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "Última Atualização" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": ["count"],
          "countRows": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "uql",
          "url": "https://api.bitbucket.org/2.0/repositories/${workspace}?pagelen=100&sort=-updated_on",
          "url_options": { "method": "GET" },
          "uql": "parse-json\n| scope \"values\"\n| project \"Nome do Repositório\"=\"name\", \"Slug\"=\"slug\", \"Projeto\"=\"project.name\", \"Linguagem\"=\"language\", \"Branch Principal\"=\"mainbranch.name\", \"Privado\"=\"is_private\", \"Última Atualização\"=\"updated_on\""
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Distribuição de Repositórios por Linguagem",
      "id": 10,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "value", "percent"],
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "uql",
          "url": "https://api.bitbucket.org/2.0/repositories/${workspace}?pagelen=100",
          "url_options": { "method": "GET" },
          "uql": "parse-json\n| scope \"values\"\n| project \"Linguagem\"=\"language\"\n| count \"Quantidade\" by \"Linguagem\""
        }
