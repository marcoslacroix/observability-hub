{
  "uid": "bitbucket-overview-dashboard",
  "title": "Bitbucket - Repositórios, PRs, Commits, Branches & Pipelines",
  "tags": ["bitbucket", "git", "ci-cd", "pull-requests", "devops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "workspace",
        "label": "Workspace Bitbucket",
        "type": "textbox",
        "query": "${BITBUCKET_WORKSPACE}",
        "current": {
          "selected": true,
          "text": "${BITBUCKET_WORKSPACE}",
          "value": "${BITBUCKET_WORKSPACE}"
        },
        "hide": 0
      },
      {
        "name": "repo_slug",
        "label": "Repositório",
        "type": "query",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
        "definition": "",
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "A",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "uql",
            "url": "https://api.bitbucket.org/2.0/repositories/${workspace}?pagelen=100&sort=-updated_on",
            "url_options": { "method": "GET" },
            "uql": "parse-json\n| scope \"values\"\n| project \"__text\"=\"name\", \"__value\"=\"slug\""
          }
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 0
      },
      {
        "name": "pr_state",
        "label": "Status dos PRs",
        "type": "custom",
        "query": "OPEN,MERGED,DECLINED,SUPERSEDED",
        "current": {
          "selected": true,
          "text": "OPEN",
          "value": "OPEN"
        },
        "options": [
          { "selected": true, "text": "OPEN", "value": "OPEN" },
          { "selected": false, "text": "MERGED", "value": "MERGED" },
          { "selected": false, "text": "DECLINED", "value": "DECLINED" },
          { "selected": false, "text": "SUPERSEDED", "value": "SUPERSEDED" }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Visão Geral do Workspace & Repositório Selecionado",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total de Repositórios no Workspace",
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^Total$/", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "uql",
          "url": "https://api.bitbucket.org/2.0/repositories/${workspace}?pagelen=1",
          "url_options": { "method": "GET" },
          "uql": "parse-json\n| project \"Total\"=\"size\""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pull Requests Abertos (Repo)",
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^Total$/", "values": false },
        "colorMode": "background",
        "graphMode": "none",
