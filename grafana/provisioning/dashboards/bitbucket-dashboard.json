            "matcher": { "id": "byName", "options": "Criado em" },
            "properties": [{ "id": "custom.width", "value": 170 }]
          },
          {
            "matcher": { "id": "byName", "options": "Atualizado em" },
            "properties": [{ "id": "custom.width", "value": 170 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": ["count"],
          "countRows": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "uql",
          "url": "https://api.bitbucket.org/2.0/repositories/${workspace}/${repo_slug}/pullrequests?state=${pr_state}&pagelen=50",
          "url_options": { "method": "GET" },
          "uql": "parse-json\n| scope \"values\"\n| project \"ID\"=\"id\", \"Título\"=\"title\", \"Autor\"=\"author.display_name\", \"Origem -> Destino\"=concat(\"source.branch.name\", ' -> ', \"destination.branch.name\"), \"Status\"=\"state\", \"Comentários\"=\"comment_count\", \"Criado em\"=\"created_on\", \"Atualizado em\"=\"updated_on\""
        }
      ]
    },
    {
