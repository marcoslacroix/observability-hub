          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "uql",
          "url": "https://api.bitbucket.org/2.0/repositories/${workspace}/${repo_slug}/refs/branches?pagelen=1",
          "url_options": { "method": "GET" },
          "uql": "parse-json\n| project \"Total\"=\"size\""
        }
