    {
      "type": "row",
      "title": "Pull Requests (${repo_slug})",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 11,
      "panels": []
    },
    {
      "type": "table",
      "title": "Pull Requests do Repositório (Filtro: ${pr_state})",
      "id": 12,
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 15 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ID" },
            "properties": [
              { "id": "custom.width", "value": 70 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Abrir PR no Bitbucket",
                    "url": "https://bitbucket.org/${workspace}/${repo_slug}/pull-requests/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Título" },
            "properties": [{ "id": "custom.width", "value": 280 }]
