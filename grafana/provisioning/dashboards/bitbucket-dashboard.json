      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bitbucket" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "uql",
          "url": "https://api.bitbucket.org/2.0/repositories/${workspace}/${repo_slug}/pullrequests?pagelen=50",
          "url_options": { "method": "GET" },
          "uql": "parse-json\n| scope \"values\"\n| project \"Autor\"=\"author.display_name\"\n| count \"Quantidade\" by \"Autor\""
        }
      ]
    },
    {
      "type": "row",
      "title": "Commits & Branches Recentes (${repo_slug})",
      "collapsed": false,
