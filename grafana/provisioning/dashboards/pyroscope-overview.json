    },
    {
      "type": "flamegraph",
      "title": "Allocation flame graph (bytes)",
      "id": 7,
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "queryType": "profile",
          "profileTypeId": "memory:alloc_in_new_tlab_bytes:bytes:space:bytes",
          "labelSelector": "{service_name=\"$service\"}",
          "groupBy": []
        }
      ]
    },
    {
      "type": "row",
      "title": "Explorer (any profile type)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "id": 8,
      "panels": [
        {
          "type": "timeseries",
          "title": "$profile_type",
          "id": 9,
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 47 },
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 1 } }, "overrides": [] },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
              "queryType": "metrics",
              "profileTypeId": "$profile_type",
              "labelSelector": "{service_name=\"$service\"}",
              "groupBy": []
            }
          ]
        },
        {
          "type": "flamegraph",
          "title": "$profile_type - flame graph",
          "id": 10,
          "gridPos": { "h": 14, "w": 24, "x": 0, "y": 55 },
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
              "queryType": "profile",
              "profileTypeId": "$profile_type",
              "labelSelector": "{service_name=\"$service\"}",
              "groupBy": []
