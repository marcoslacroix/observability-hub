{
  "uid": "micrometer-business-metrics",
  "title": "Micrometer - Métricas de Negócio (Utilizadores & Impostos)",
  "description": "Dashboard de métricas customizadas do MicrometerService: Counter (user.registrations.total) e Timer (business.tax.calculation.time)",
  "tags": ["micrometer", "business", "spring-boot", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_info, application)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(jvm_info, application)",
        "refresh": 2,
        "sort": 1,
        "current": { "text": "observability-hub", "value": "observability-hub" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Registo de Utilizadores — Counter (user_registrations_total)",
      "collapsed": false,
      "id": 1,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Registos com Sucesso",
      "description": "Total acumulado de registos de utilizadores bem-sucedidos (status=success)",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(user_registrations_total{application=\"$application\", status=\"success\"}) or vector(0)",
          "legendFormat": "Sucesso"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Registos com Falha",
      "description": "Total acumulado de tentativas de registo falhadas (status=failure)",
      "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(user_registrations_total{application=\"$application\", status=\"failure\"}) or vector(0)",
          "legendFormat": "Falha"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Taxa de Sucesso no Registo",
      "description": "Percentual de registos bem-sucedidos sobre o total de tentativas",
      "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(user_registrations_total{application=\"$application\", status=\"success\"}) / clamp_min(sum(user_registrations_total{application=\"$application\"}), 1)",
          "legendFormat": "Taxa de Sucesso"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Proporção Sucesso vs. Falha",
      "id": 5,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "displayLabels": ["percent", "value"],
        "legend": { "displayMode": "list", "placement": "right", "values": ["value", "percent"] },
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (user_registrations_total{application=\"$application\"})",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total Acumulado de Registos por Status",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (user_registrations_total{application=\"$application\"})",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Taxa de Registos de Utilizadores (req/s)",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(user_registrations_total{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cálculo Complexo de Impostos — Timer (business_tax_calculation_time_seconds)",
      "collapsed": false,
      "id": 10,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total de Cálculos Executados",
      "description": "Quantidade total de chamadas a performHeavyCalculations registradas pelo Timer",
      "id": 11,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(business_tax_calculation_time_seconds_count{application=\"$application\"}) or vector(0)",
          "legendFormat": "Execuções"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tempo Médio de Cálculo",
      "description": "Duração média de performHeavyCalculations (1s a 5s)",
      "id": 12,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 4.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(business_tax_calculation_time_seconds_sum{application=\"$application\"}) / clamp_min(sum(business_tax_calculation_time_seconds_count{application=\"$application\"}), 1)",
          "legendFormat": "Média (s)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tempo Máximo (Pico Recente)",
      "description": "Maior duração registrada recentemente pelo Timer (business_tax_calculation_time_seconds_max)",
      "id": 13,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3.5 },
              { "color": "red", "value": 4.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(business_tax_calculation_time_seconds_max{application=\"$application\"}) or vector(0)",
          "legendFormat": "Máximo (s)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tempo Total Acumulado em Cálculos",
      "description": "Soma total de segundos gastos em performHeavyCalculations (business_tax_calculation_time_seconds_sum)",
      "id": 14,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(business_tax_calculation_time_seconds_sum{application=\"$application\"}) or vector(0)",
          "legendFormat": "Soma (s)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duração do Cálculo de Impostos por Região (Média vs. Máximo)",
      "id": 15,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (region) (rate(business_tax_calculation_time_seconds_sum{application=\"$application\"}[$__rate_interval])) / sum by (region) (rate(business_tax_calculation_time_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "Média (region={{region}})"
        },
        {
          "refId": "B",
          "expr": "max by (region) (business_tax_calculation_time_seconds_max{application=\"$application\"})",
          "legendFormat": "Máximo (region={{region}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Execuções de Cálculo de Impostos por Região (Acumulado & Taxa/s)",
      "id": 16,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (region) (business_tax_calculation_time_seconds_count{application=\"$application\"})",
          "legendFormat": "Total acumulado (region={{region}})"
        },
        {
          "refId": "B",
          "expr": "sum by (region) (rate(business_tax_calculation_time_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "Taxa/s (region={{region}})"
        }
      ]
    }
  ]
}
