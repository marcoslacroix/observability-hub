{
  "uid": "kafka-observability-dashboard",
  "title": "Apache Kafka - Observabilidade Completa (Producer, Consumer, Lag, Rede & Traces)",
  "description": "Dashboard completo de observabilidade do Apache Kafka e Spring Kafka: Throughput, Consumer Lag por Partição, Latência de Publicação e Processamento, Saúde do Coordinator/Rebalance, Buffer do Producer, Rede/IO, Traces (Tempo) e Logs (Loki).",
  "tags": ["kafka", "spring-kafka", "prometheus", "opentelemetry", "tempo", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Aplicação",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(kafka_app_info_start_time_ms, application)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(kafka_app_info_start_time_ms, application)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "observability-hub",
          "value": "observability-hub"
        }
      },
      {
        "name": "topic",
        "label": "Tópico",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(kafka_consumer_fetch_manager_records_lag{application=\"$application\"}, topic)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(kafka_consumer_fetch_manager_records_lag{application=\"$application\"}, topic)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ["$__all"]
        }
      },
      {
        "name": "producer_client",
        "label": "Producer Client ID",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(kafka_producer_record_send_total{application=\"$application\"}, client_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(kafka_producer_record_send_total{application=\"$application\"}, client_id)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ["$__all"]
        }
      },
      {
        "name": "consumer_client",
        "label": "Consumer Client ID",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(kafka_consumer_fetch_manager_fetch_total{application=\"$application\"}, client_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(kafka_consumer_fetch_manager_fetch_total{application=\"$application\"}, client_id)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "1. Visão Geral & Saúde do Cluster / Clientes Kafka (KPIs)",
      "collapsed": false,
      "id": 1,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Mensagens Publicadas (Total)",
      "description": "Total acumulado de mensagens publicadas pela aplicação (kafka_messages_published_total)",
      "id": 2,
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_messages_published_total{application=\"$application\"}) or vector(0)",
          "legendFormat": "Publicadas"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Mensagens Consumidas (Total)",
      "description": "Total acumulado de mensagens consumidas pela aplicação (kafka_messages_consumed_total)",
      "id": 3,
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_messages_consumed_total{application=\"$application\"}) or vector(0)",
          "legendFormat": "Consumidas"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Consumer Lag Total",
      "description": "Soma do lag atual de todas as partições monitoradas (kafka_consumer_fetch_manager_records_lag)",
      "id": 4,
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumer_fetch_manager_records_lag{application=\"$application\", topic=~\"$topic\", client_id=~\"$consumer_client\"}) or vector(0)",
          "legendFormat": "Lag Total"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Erros de Publicação (Producer)",
      "description": "Total de falhas de envio no Kafka Producer e KafkaTemplate",
      "id": 5,
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(kafka_producer_record_error_total{application=\"$application\", client_id=~\"$producer_client\"}) or vector(0)) + (sum(spring_kafka_template_seconds_count{application=\"$application\", error!=\"none\"}) or vector(0))",
          "legendFormat": "Erros Producer"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Erros no Consumer (@KafkaListener)",
      "description": "Total de falhas durante o processamento de mensagens nos listeners Spring Kafka",
      "id": 6,
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(spring_kafka_listener_seconds_count{application=\"$application\", error!=\"none\"}) or vector(0)",
          "legendFormat": "Erros Consumer"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Partições Atribuídas",
      "description": "Total de partições atualmente atribuídas aos consumidores ativos",
      "id": 7,
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumer_coordinator_assigned_partitions{application=\"$application\", client_id=~\"$consumer_client\"}) or vector(0)",
          "legendFormat": "Partições"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Conexões Ativas (Prod + Cons)",
      "description": "Soma das conexões TCP ativas do Producer e dos Consumers com os brokers Kafka",
      "id": 8,
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(kafka_producer_connection_count{application=\"$application\", client_id=~\"$producer_client\"}) or vector(0)) + (sum(kafka_consumer_connection_count{application=\"$application\", client_id=~\"$consumer_client\"}) or vector(0))",
          "legendFormat": "Conexões"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime do Cliente Kafka",
      "description": "Tempo desde a inicialização do cliente Kafka na aplicação",
      "id": 9,
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (min(kafka_app_info_start_time_ms{application=\"$application\"}) / 1000)",
          "legendFormat": "Uptime"
        }
      ]
    },
    {
      "type": "row",
      "title": "2. Fluxo de Mensagens & Spring Kafka (KafkaTemplate, @KafkaListener & HTTP /kafka)",
      "collapsed": false,
      "id": 10,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Throughput da Aplicação: Publicadas vs. Consumidas (msg/s)",
      "description": "Taxa de mensagens publicadas e consumidas por segundo na aplicação",
      "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kafka_messages_published_total{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "Publicadas (App msg/s)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(kafka_messages_consumed_total{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "Consumidas (App msg/s)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Volume Acumulado por Tópico (Enviadas vs. Consumidas)",
      "description": "Total de registros enviados pelo Producer e consumidos pelo Fetch Manager separados por tópico",
      "id": 12,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_producer_topic_record_send_total{application=\"$application\", topic=~\"$topic\", client_id=~\"$producer_client\"})",
          "legendFormat": "Produzidas [{{topic}}]"
        },
        {
          "refId": "B",
          "expr": "sum by (topic) (kafka_consumer_fetch_manager_records_consumed_total{application=\"$application\", topic=~\"$topic\", client_id=~\"$consumer_client\"})",
          "legendFormat": "Consumidas [{{topic}}]"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Endpoints HTTP /kafka/* — Taxa de Requisições & Latência Média",
      "description": "Monitoramento dos endpoints REST /kafka/publish e /kafka/consumed",
      "id": 13,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Latência.*" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/kafka.*\"}[$__rate_interval]))",
          "legendFormat": "{{uri}} [HTTP {{status}}] (req/s)"
        },
        {
          "refId": "B",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{application=\"$application\", uri=~\"/kafka.*\"}[$__rate_interval])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/kafka.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "Latência Média {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência de Publicação — Spring KafkaTemplate (Média & Máxima por Tópico)",
      "description": "Tempo gasto pelo KafkaTemplate para publicar eventos em cada tópico (spring_kafka_template_seconds)",
      "id": 14,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_destination_name) (rate(spring_kafka_template_seconds_sum{application=\"$application\", messaging_destination_name=~\"$topic\"}[$__rate_interval])) / clamp_min(sum by (messaging_destination_name) (rate(spring_kafka_template_seconds_count{application=\"$application\", messaging_destination_name=~\"$topic\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "Média Publish [{{messaging_destination_name}}]"
        },
        {
          "refId": "B",
          "expr": "max by (messaging_destination_name) (spring_kafka_template_seconds_max{application=\"$application\", messaging_destination_name=~\"$topic\"})",
          "legendFormat": "Pico (Max) Publish [{{messaging_destination_name}}]"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência de Processamento — Spring @KafkaListener (Média & Máxima por Tópico)",
      "description": "Tempo gasto pelos métodos @KafkaListener para processar cada mensagem consumida (spring_kafka_listener_seconds)",
      "id": 15,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_source_name, messaging_kafka_consumer_group) (rate(spring_kafka_listener_seconds_sum{application=\"$application\", messaging_source_name=~\"$topic\"}[$__rate_interval])) / clamp_min(sum by (messaging_source_name, messaging_kafka_consumer_group) (rate(spring_kafka_listener_seconds_count{application=\"$application\", messaging_source_name=~\"$topic\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "Média Listener [{{messaging_source_name}} | {{messaging_kafka_consumer_group}}]"
        },
        {
          "refId": "B",
          "expr": "max by (messaging_source_name, messaging_kafka_consumer_group) (spring_kafka_listener_seconds_max{application=\"$application\", messaging_source_name=~\"$topic\"})",
          "legendFormat": "Pico (Max) Listener [{{messaging_source_name}} | {{messaging_kafka_consumer_group}}]"
        }
      ]
    },
    {
      "type": "row",
      "title": "3. Consumer Lag, Partições & Fetch Manager (Detalhamento por Tópico e Partição)",
      "collapsed": false,
      "id": 20,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Consumer Lag por Tópico e Partição (records_lag)",
      "description": "Quantidade de mensagens pendentes de leitura por partição em cada tópico. Valores crescentes indicam gargalo no consumidor.",
      "id": 21,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_fetch_manager_records_lag{application=\"$application\", topic=~\"$topic\", client_id=~\"$consumer_client\"}",
          "legendFormat": "{{topic}} [partição {{partition}}] ({{client_id}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer Lead por Tópico e Partição (records_lead)",
      "description": "Diferença entre o offset atual do consumidor e o menor offset disponível na partição (log start offset)",
      "id": 22,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_fetch_manager_records_lead{application=\"$application\", topic=~\"$topic\", client_id=~\"$consumer_client\"}",
          "legendFormat": "{{topic}} [partição {{partition}}]"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência de Fetch Requests do Consumer (Média vs. Máxima)",
      "description": "Tempo que o Fetch Manager leva para buscar lotes de registros nos brokers Kafka",
      "id": 23,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_fetch_manager_fetch_latency_avg{application=\"$application\", client_id=~\"$consumer_client\"}",
          "legendFormat": "Média Fetch ({{client_id}})"
        },
        {
          "refId": "B",
          "expr": "kafka_consumer_fetch_manager_fetch_latency_max{application=\"$application\", client_id=~\"$consumer_client\"}",
          "legendFormat": "Máx Fetch ({{client_id}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Taxa de Consumo por Tópico (Registros/s & Bytes/s)",
      "description": "Velocidade de leitura dos tópicos pelo Fetch Manager",
      "id": 24,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
