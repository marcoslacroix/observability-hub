{
  "uid": "kafka-stress-metrics",
  "title": "Apache Kafka - Stress Test, Vazão & Tempo de Processamento",
  "description": "Dashboard de observabilidade dos fluxos Apache Kafka (Producer, Consumer e Endpoints HTTP do Stress Test k6)",
  "tags": ["kafka", "k6", "micrometer", "spring-boot", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_info, application)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(jvm_info, application)",
        "refresh": 2,
        "sort": 1,
        "current": { "text": "observability-hub", "value": "observability-hub" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "1. Resumo de Processamento Kafka — Sucesso, Falhas & Consumer Lag",
      "collapsed": false,
      "id": 1,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Publicações com Sucesso",
      "description": "Total acumulado de mensagens publicadas com sucesso no Kafka (status=success)",
      "id": 2,
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_messages_published_total{application=\"$application\", status=\"success\"}) or vector(0)",
          "legendFormat": "Publicadas (Sucesso)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Publicações com Falha",
      "description": "Total acumulado de falhas ao publicar no Kafka (status=failure)",
      "id": 3,
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_messages_published_total{application=\"$application\", status=\"failure\"}) or vector(0)",
          "legendFormat": "Publicadas (Falha)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Consumidas com Sucesso",
      "description": "Total acumulado de mensagens processadas pelos @KafkaListeners com sucesso",
      "id": 4,
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_messages_consumed_total{application=\"$application\", status=\"success\"}) or vector(0)",
          "legendFormat": "Consumidas (Sucesso)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Falhas no Consumer",
      "description": "Total acumulado de erros nos @KafkaListeners (status=failure)",
      "id": 5,
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_messages_consumed_total{application=\"$application\", status=\"failure\"}) or vector(0)",
          "legendFormat": "Consumidas (Falha)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Taxa de Sucesso (Producer)",
      "description": "Percentual de mensagens publicadas com sucesso sobre o total de tentativas",
      "id": 6,
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_messages_published_total{application=\"$application\", status=\"success\"}) / clamp_min(sum(kafka_messages_published_total{application=\"$application\"}), 1)",
          "legendFormat": "Taxa de Sucesso"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Consumer Lag Residual",
      "description": "Diferença entre mensagens publicadas com sucesso e mensagens já consumidas",
      "id": 7,
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((sum(kafka_messages_published_total{application=\"$application\", status=\"success\"}) or vector(0)) - (sum(kafka_messages_consumed_total{application=\"$application\", status=\"success\"}) or vector(0)), 0)",
          "legendFormat": "Lag"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Vazão de Mensagens no Kafka: Publicadas vs. Consumidas (msg/s)",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Publicadas - success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Publicadas - failure" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Consumidas - success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(kafka_messages_published_total{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "Publicadas - {{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (status) (rate(kafka_messages_consumed_total{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "Consumidas - {{status}}"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Proporção Sucesso vs. Falha (Publicação + Registo)",
      "id": 9,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Kafka Publicadas (success)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Kafka Publicadas (failure)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Registo Utilizador (failure)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "displayLabels": ["percent", "value"],
        "legend": { "displayMode": "list", "placement": "bottom", "values": ["value", "percent"] },
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (kafka_messages_published_total{application=\"$application\"})",
          "legendFormat": "Kafka Publicadas ({{status}})"
        },
        {
          "refId": "B",
          "expr": "sum(user_registrations_total{application=\"$application\", status=\"failure\"})",
          "legendFormat": "Registo Utilizador (failure)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total Acumulado (Publicadas vs. Consumidas)",
      "id": 10,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_messages_published_total{application=\"$application\", status=\"success\"})",
          "legendFormat": "Publicadas (Sucesso)"
        },
        {
          "refId": "B",
          "expr": "sum(kafka_messages_consumed_total{application=\"$application\", status=\"success\"})",
          "legendFormat": "Consumidas (Sucesso)"
        },
        {
          "refId": "C",
          "expr": "sum(kafka_messages_published_total{application=\"$application\", status=\"failure\"}) + sum(user_registrations_total{application=\"$application\", status=\"failure\"})",
          "legendFormat": "Total de Falhas"
        }
      ]
    },
    {
      "type": "row",
      "title": "2. Tempo de Processamento do Kafka (Micrometer Timer) & Latência das Requisições HTTP",
      "collapsed": false,
      "id": 11,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Tempo Médio Publicação (Producer ACK)",
      "description": "Tempo médio desde o envio até a confirmação (ACK) do broker Kafka (kafka_producer_processing_time_seconds)",
      "id": 12,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_producer_processing_time_seconds_sum{application=\"$application\"}) / clamp_min(sum(kafka_producer_processing_time_seconds_count{application=\"$application\"}), 1)",
          "legendFormat": "Média Producer"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tempo Máximo Publicação (Pico Producer)",
      "description": "Maior tempo de ACK do Kafka Producer registrado recentemente (kafka_producer_processing_time_seconds_max)",
      "id": 13,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kafka_producer_processing_time_seconds_max{application=\"$application\"}) or vector(0)",
          "legendFormat": "Pico Producer"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tempo Médio Consumo (@KafkaListener)",
      "description": "Tempo médio de processamento das mensagens no KafkaConsumerService (kafka_consumer_processing_time_seconds)",
      "id": 14,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumer_processing_time_seconds_sum{application=\"$application\"}) / clamp_min(sum(kafka_consumer_processing_time_seconds_count{application=\"$application\"}), 1)",
          "legendFormat": "Média Consumer"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tempo Máximo Consumo (Pico Consumer)",
      "description": "Maior tempo de processamento registrado no consumidor Kafka (kafka_consumer_processing_time_seconds_max)",
      "id": 15,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.2 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kafka_consumer_processing_time_seconds_max{application=\"$application\"}) or vector(0)",
          "legendFormat": "Pico Consumer"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tempo de Processamento no Kafka por Tópico (Producer ACK vs. Consumer)",
      "description": "Evolução temporal da duração média e máxima de publicação e consumo medida pelos Timers do Micrometer",
      "id": 16,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (topic, status) (rate(kafka_producer_processing_time_seconds_sum{application=\"$application\"}[$__rate_interval])) / (sum by (topic, status) (rate(kafka_producer_processing_time_seconds_count{application=\"$application\"}[$__rate_interval])) > 0)) or (sum by (topic, status) (kafka_producer_processing_time_seconds_sum{application=\"$application\"}) / clamp_min(sum by (topic, status) (kafka_producer_processing_time_seconds_count{application=\"$application\"}), 1))",
          "legendFormat": "Média Producer [{{topic}} | {{status}}]"
        },
        {
          "refId": "B",
          "expr": "max by (topic) (kafka_producer_processing_time_seconds_max{application=\"$application\"}) > 0",
          "legendFormat": "Pico Producer [{{topic}}]"
        },
        {
          "refId": "C",
          "expr": "(sum by (topic, status) (rate(kafka_consumer_processing_time_seconds_sum{application=\"$application\"}[$__rate_interval])) / (sum by (topic, status) (rate(kafka_consumer_processing_time_seconds_count{application=\"$application\"}[$__rate_interval])) > 0)) or (sum by (topic, status) (kafka_consumer_processing_time_seconds_sum{application=\"$application\"}) / clamp_min(sum by (topic, status) (kafka_consumer_processing_time_seconds_count{application=\"$application\"}), 1))",
          "legendFormat": "Média Consumer [{{topic}} | {{status}}]"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tempo de Resposta de Todas as Requests HTTP (Por Endpoint e Status)",
      "description": "Latência HTTP em tempo real e histórica de todas as requisições da aplicação",
      "id": 17,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (method, uri, status) (rate(http_server_requests_seconds_sum{application=\"$application\", uri!~\"/actuator.*\"}[$__rate_interval])) / (sum by (method, uri, status) (rate(http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*\"}[$__rate_interval])) > 0)) or (sum by (method, uri, status) (http_server_requests_seconds_sum{application=\"$application\", uri!~\"/actuator.*\"}) / clamp_min(sum by (method, uri, status) (http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*\"}), 1))",
          "legendFormat": "Tempo Médio [{{method}} {{uri}} - HTTP {{status}}]"
        },
        {
          "refId": "B",
          "expr": "max by (method, uri) (http_server_requests_seconds_max{application=\"$application\", uri!~\"/actuator.*\"}) > 0",
          "legendFormat": "Pico Máximo [{{method}} {{uri}}]"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Comparativo de Tempo Médio de Todas as Requests HTTP (Por Rota e Status)",
      "description": "Duração média acumulada de cada endpoint HTTP acionado na aplicação",
      "id": 19,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri, status) (http_server_requests_seconds_sum{application=\"$application\", uri!~\"/actuator.*\"}) / clamp_min(sum by (method, uri, status) (http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*\"}), 1)",
          "legendFormat": "{{method}} {{uri}} (HTTP {{status}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Taxa de Requisições HTTP de Todas as Rotas (req/s) & Total de Chamadas",
      "id": 18,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri, status) (http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*\"})",
          "legendFormat": "Total Requests [{{method}} {{uri}} - HTTP {{status}}]"
        }
      ]
    }
  ]
}
