{
  "uid": "spring-boot-prometheus",
  "title": "Spring Boot - JVM & HTTP (Prometheus)",
  "tags": ["prometheus", "spring-boot", "jvm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_info, application)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(jvm_info, application)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_info{application=\"$application\"}, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(jvm_info{application=\"$application\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Overview", "collapsed": false, "id": 1, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat", "title": "Uptime", "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "max(process_uptime_seconds{application=\"$application\", instance=~\"$instance\"})" } ]
    },
    {
      "type": "stat", "title": "Heap used", "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "sum(jvm_memory_used_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"} > 0)" } ]
    },
    {
      "type": "stat", "title": "Process CPU", "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "max(process_cpu_usage{application=\"$application\", instance=~\"$instance\"})" } ]
    },
    {
      "type": "stat", "title": "Live threads", "id": 5,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "sum(jvm_threads_live_threads{application=\"$application\", instance=~\"$instance\"})" } ]
    },
    {
      "type": "stat", "title": "Requests/s", "id": 6,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))" } ]
    },
    {
      "type": "stat", "title": "5xx errors", "id": 7,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "(sum(rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", outcome=\"SERVER_ERROR\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))" } ]
    },

    { "type": "row", "title": "HTTP", "collapsed": false, "id": 10, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": [] },
    {
      "type": "timeseries", "title": "Requests/s by URI", "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{method}} {{uri}}" } ]
    },
    {
      "type": "timeseries", "title": "Average latency by URI", "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{method}} {{uri}}" } ]
    },
    {
      "type": "timeseries", "title": "Max latency by URI", "id": 13,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "max by (method, uri) (http_server_requests_seconds_max{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"})", "legendFormat": "{{method}} {{uri}}" } ]
    },
    {
      "type": "timeseries", "title": "Requests/s by status", "id": 14,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{status}}" } ]
    },

    { "type": "row", "title": "JVM memory & GC", "collapsed": false, "id": 20, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "panels": [] },
    {
      "type": "timeseries", "title": "Heap by pool", "id": 21,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (id) (jvm_memory_used_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"})", "legendFormat": "{{id}}" } ]
    },
    {
      "type": "timeseries", "title": "Non-heap by pool", "id": 22,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (id) (jvm_memory_used_bytes{application=\"$application\", instance=~\"$instance\", area=\"nonheap\"})", "legendFormat": "{{id}}" } ]
    },
    {
      "type": "timeseries", "title": "Allocation rate", "description": "Bytes allocated per second on the heap. Use the Pyroscope dashboard's allocation flame graph to see where it comes from.", "id": 23,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(jvm_gc_memory_allocated_bytes_total{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "allocated" },
        { "refId": "B", "expr": "sum(rate(jvm_gc_memory_promoted_bytes_total{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "promoted to old gen" }
      ]
    },
    {
      "type": "timeseries", "title": "GC pauses/s", "id": 24,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{action}} ({{cause}})" } ]
    },
    {
      "type": "timeseries", "title": "GC pause time", "id": 25,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])) / sum(rate(jvm_gc_pause_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "avg pause" },
        { "refId": "B", "expr": "max(jvm_gc_pause_seconds_max{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "max pause" }
      ]
    },

    { "type": "row", "title": "CPU, threads & logs", "collapsed": false, "id": 30, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "panels": [] },
    {
      "type": "timeseries", "title": "CPU usage", "id": 31,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "max(process_cpu_usage{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "process" },
        { "refId": "B", "expr": "max(system_cpu_usage{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "system" }
      ]
    },
    {
      "type": "timeseries", "title": "Threads by state", "id": 32,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (state) (jvm_threads_states_threads{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "{{state}}" } ]
    },
    {
      "type": "timeseries", "title": "Log events/s by level", "id": 33,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (level) (rate(logback_events_total{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{level}}" } ]
    }
  ]
}
